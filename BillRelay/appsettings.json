{
  "delivery": {
    "recipient": "recipient@example.com",
    "senderName": "BillRelay",
    "templatePath": "email-template.xml"
  },
  "notifications": {
    "baseUrl": "https://notifications.example.com",
    "apiKey": "",
    "hmacSharedSecretKey": ""
  },
  "imap": {
    "server": "imap.example.com",
    "port": 993,
    "mailbox": "INBOX",
    "username": "user@example.com",
    "password": "",
    "useSsl": true,
    "validateCertificates": true
  },
  "polling": {
    "maximumEmailAgeDays": 30,
    "intervalSeconds": 300,
    "initialProcessingDate": null
  },
  "filters": {
    "providers": ["Vodafone", "Electrica Furnizare", "E-bloc"],
    "senderPatterns": [
      "billing@",
      "invoices@",
      "noreply@"
    ],
    "subjectPatterns": [
      "invoice",
      "bill",
      "statement",
      "payment"
    ]
  },
  "attachments": {
    "permittedMimeTypes": [
      "application/pdf"
    ],
    "maxSizeBytes": 25000000
  },
  "storage": {
    "downloadDirectory": "./bills",
    "stateFilePath": "./state/billrelay.json"
  },
  "retention": {
    "maxAgeDays": 365,
    "maxFiles": 10000
  }
}