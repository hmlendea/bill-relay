{
  "NuciLoggerSettings": {
    "MinimumLevel": "Info",
    "IsFileOutputEnabled": false
  },
  "delivery": {
    "recipient": "[[DELIVERY_RECIPIENT]]",
    "senderName": "[[DELIVERY_SENDER_NAME]]",
    "templatePath": "[[DELIVERY_TEMPLATE_PATH]]"
  },
  "nuciNotificationsSettings": {
    "baseUrl": "[[NUCINOTIFICATIONS_BASE_URL]]",
    "apiKey": "[[NUCINOTIFICATIONS_API_KEY]]",
    "hmacSharedSecretKey": "[[NUCINOTIFICATIONS_API_HMAC_SIGNING_KEY]]"
  },
  "imap": {
    "server": "[[IMAP_SERVER]]",
    "port": "[[IMAP_PORT]]",
    "mailbox": "INBOX",
    "username": "[[IMAP_USERNAME]]",
    "password": "[[IMAP_PASSWORD]]",
    "useSsl": true,
    "validateCertificates": true
  },
  "polling": {
    "maximumEmailAgeDays": 21,
    "intervalSeconds": 300,
    "initialProcessingDate": null
  },
  "filters": {
    "providers": ["Vodafone", "Electrica Furnizare", "E-bloc", "Hidroelectrica"],
    "senderPatterns": [
      "billing@",
      "invoices@",
      "noreply@"
    ],
    "subjectPatterns": [
      "invoice",
      "bill",
      "statement",
      "payment"
    ]
  },
  "attachments": {
    "permittedMimeTypes": [
      "application/pdf"
    ],
    "maxSizeBytes": 25000000
  },
  "storage": {
    "downloadDirectory": "./bills",
    "stateFilePath": "./state/billrelay.json"
  },
  "retention": {
    "maxAgeDays": 365,
    "maxFiles": 10000
  }
}